# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---

# Convex. `npx convex dev` writes these on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Shared secret between the site and Convex. Any long random string.
# Also set it in Convex: npx convex env set STORE_SERVER_SECRET <value>
STORE_SERVER_SECRET=

# Clerk auth (dashboard.clerk.com, API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Gemini, used for narration, images and speech
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Optional ---

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Clerk user ids that can open admin pages
ADMIN_USER_IDS=

# OpenAI, exported in lib/ai/llm.ts but not the current model
OPENAI_API_KEY=

# Skip paid image and speech generation in local dev
NEXT_PUBLIC_USE_PLACEHOLDER_IMAGES=
USE_PLACEHOLDER_TTS=
GEMINI_TTS_MODEL=

# S3 and CloudFront for uploads and stage assets (pnpm stage:sync)
AWS_KEY=
AWS_SECRET=
AWS_REGION=
AWS_BUCKET_DATA=
AWS_BUCKET_PUBLIC=
CLOUDFRONT_DOMAIN=
# Set to the same address on the live site, so stage art skips the deploy's relay. The host must allow cross-origin reads.
NEXT_PUBLIC_ASSET_HOST=

# Email: contact form, mailing list
SENDGRID_API_KEY=
SENDGRID_SENDER=
RESEND_API_KEY=
CONTACT_EMAIL=
UNSUBSCRIBE_SECRET=

# reCAPTCHA on public forms
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Replicate, used by the asset pipeline
REPLICATE_API_TOKEN=
REPLICATE_MODEL=
