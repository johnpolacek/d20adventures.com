{
  "name": "d20adventures.com",
  "version": "0.1.0",
  "license": "None",
  "description": "An open source platform for building and playing 5e fantasy adventures with an AI Game Master, solo or multiplayer.",
  "keywords": [
    "nextjs",
    "template",
    "starter",
    "vibecoding"
  ],
  "author": "johnpolacek",
  "scripts": {
    "kill:ports": "kill-port 1422 3000 4000 4400 4500 5001 8080 8085 9000 9099 9199 || true",
    "dev": "concurrently \"pnpm convex:dev\" \"next dev -p ${PORT:-3000}\" \"pnpm dev:app\" --kill-others-on-fail --names \"convex,next,app\" --prefix-colors \"yellow.bold,cyan.bold,magenta.bold\"",
    "dev:web": "concurrently \"pnpm convex:dev\" \"next dev -p ${PORT:-3000}\" --kill-others --names \"convex,next\" --prefix-colors \"yellow.bold,cyan.bold\"",
    "dev:fresh": "pnpm kill:ports && pnpm dev",
    "dev:app": "D20_SITE_URL=http://localhost:${PORT:-3000} pnpm desktop:dev",
    "desktop:review": "concurrently \"next dev -p 3058\" \"D20_REQUIRE_ACCOUNT=1 D20_SITE_URL=http://localhost:3058 pnpm --dir apps/desktop tauri dev\" --kill-others --names \"site,app\" --prefix-colors \"cyan.bold,magenta.bold\"",
    "wt:doctor": "sh ./scripts/wt.sh doctor",
    "wt:create": "sh ./scripts/wt.sh create",
    "wt:seed": "sh ./scripts/wt.sh seed",
    "wt:list": "sh ./scripts/wt.sh list",
    "wt:resume": "sh ./scripts/wt.sh resume",
    "wt:dev": "sh ./scripts/wt.sh dev",
    "wt:open": "sh ./scripts/wt.sh open",
    "wt:finish": "sh ./scripts/wt.sh finish",
    "wt:clean": "sh ./scripts/wt.sh clean",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "build": "node packages/ui/scripts/check-imports.mjs && next build",
    "postinstall": "npx convex codegen",
    "start": "next start",
    "boot:convex": "sh ./scripts/boot-convex.sh",
    "boot:github": "brew install gh && gh auth login",
    "boot:vercel": "pnpm i -g vercel",
    "boot:repo": "chmod +x ./scripts/init-repo.sh && ./scripts/init-repo.sh",
    "boot": "pnpm boot:github && pnpm boot:vercel && pnpm boot:convex && pnpm boot:repo",
    "go": "git add . && aicommits && git add . && git commit -m 'update llm.txt' && pnpm convex:deploy && git push origin main",
    "test:run": "playwright test",
    "test:store": "tsx --test lib/store/*.test.ts lib/desktop/*.test.ts",
    "test:auth": "playwright test tests/auth.spec.ts tests/api-auth.spec.ts",
    "test:wait": "wait-on tcp:3000 tcp:4000 && pnpm test:run",
    "test": "pnpm build && concurrently \"pnpm kill:ports && pnpm dev:web\" \"pnpm test:wait\" --success first --kill-others --names \"dev,test\" --prefix-colors \"yellow.bold,cyan.bold\"",
    "ship": "pnpm test && pnpm go",
    "push": "pnpm convex:deploy && git push origin main",
    "push:now": "convex deploy --yes && git push origin main",
    "test:clean": "rm -rf ~/.cache/ms-playwright-tests test-results/ playwright-report/",
    "pw": "playwright test --ui --debug",
    "pw:headless": "playwright test",
    "db:admin": "open https://dashboard.convex.dev",
    "assets": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx asset-library/pipeline/build.ts",
    "assets:thumbs": "tsx asset-library/pipeline/thumbs.ts",
    "assets:views": "tsx asset-library/pipeline/views.ts",
    "assets:pilot": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx asset-library/pipeline/pilot.ts",
    "assets:arms": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx asset-library/pipeline/armcheck.ts",
    "assets:parts": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx asset-library/pipeline/parts.ts",
    "assets:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx asset-library/pipeline/sync.ts",
    "assets:archive": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx asset-library/pipeline/archive.ts",
    "assets:fetch": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx asset-library/pipeline/archive.ts --fetch",
    "packages:build": "tsx scripts/adventure-packages.ts",
    "packages:check": "tsx scripts/adventure-packages.ts --check",
    "stage:check": "tsx scripts/stage-check.ts",
    "stage:plans": "tsx scripts/stage-plans.ts",
    "stage:plans:check": "tsx scripts/stage-plans.ts --check",
    "map:check": "tsx scripts/city-map-check.ts",
    "stage:sync": "node --env-file=.env.local --import tsx scripts/stage-assets-sync.ts",
    "images:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/images-sync.ts",
    "stage:verify": "tsx scripts/stage-verify.ts",
    "stage:director": "tsx scripts/stage-director-check.ts",
    "test:wiki-adventures:batch-a": "tsx scripts/wiki-adventures-batch-a-check.ts",
    "test:wiki-adventures:batch-b": "tsx scripts/wiki-adventures-batch-b-check.ts",
    "test:wiki-adventures:batch-c": "tsx scripts/wiki-adventures-batch-c-check.ts",
    "test:wiki-adventures:batch-d": "tsx scripts/wiki-adventures-batch-d-check.ts",
    "test:wiki-adventures:batch-e": "tsx scripts/wiki-adventures-batch-e-check.ts",
    "test:wiki-adventures:batch-f": "tsx scripts/wiki-adventures-batch-f-check.ts",
    "migrate:midnight-summons": "tsx scripts/migrate-midnight-summons.ts",
    "migrate:covert-cargo": "tsx scripts/migrate-covert-cargo.ts",
    "migrate:road-to-kordavos": "tsx scripts/migrate-road-to-kordavos.ts",
    "migrate:welcome-to-kordavos": "tsx scripts/migrate-welcome-to-kordavos.ts",
    "test:wiki-adventures:midnight-bridge": "tsx scripts/wiki-adventures-midnight-bridge-check.ts",
    "test:wiki-adventures:covert-cargo-bridge": "tsx scripts/wiki-adventures-covert-cargo-bridge-check.ts",
    "test:wiki-adventures:road-to-kordavos-bridge": "tsx scripts/wiki-adventures-road-to-kordavos-bridge-check.ts",
    "test:wiki-adventures:welcome-to-kordavos-bridge": "tsx scripts/wiki-adventures-welcome-to-kordavos-bridge-check.ts",
    "test:wiki-adventures:admin-authoring": "tsx scripts/wiki-adventures-admin-authoring-check.ts",
    "test:wiki-adventures:public-flow": "tsx scripts/wiki-adventures-public-flow-check.ts",
    "test:wiki-adventures:rollback": "tsx scripts/wiki-adventures-rollback-check.ts",
    "audit:wiki-adventures:prod-s3": "node --env-file=.env --env-file=.env.local --import tsx scripts/wiki-adventures-prod-s3-audit.ts",
    "test:setup": "pnpm dev:web",
    "test:full": "pnpm test:setup && pnpm test",
    "test:srd": "pnpm --filter @d20/srd check && pnpm --filter @d20/srd verify",
    "test:gm-core": "tsx scripts/gm-core-check.ts && tsx scripts/gm-server-check.ts && tsc -p convex/tsconfig.json --noEmit",
    "desktop:dev": "pnpm --filter @d20/desktop tauri dev",
    "desktop:build": "pnpm --filter @d20/desktop tauri build",
    "desktop:release": "sh scripts/desktop-release.sh",
    "desktop:wipe": "NODE_NO_WARNINGS=1 tsx scripts/desktop-wipe.ts",
    "content:mine": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/content-mine.ts",
    "content:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/content-sync.ts",
    "content:video": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/content-video.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/replicate": "^2.0.24",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@clerk/backend": "^3.31.2",
    "@clerk/nextjs": "^7.10.5",
    "@clerk/themes": "^2.4.57",
    "@d20/gm-core": "workspace:*",
    "@d20/srd": "workspace:*",
    "@d20/stage": "workspace:*",
    "@d20/ui": "workspace:*",
    "@gsap/react": "2.1.2",
    "@heroicons/react": "^2.2.0",
    "@sendgrid/mail": "^8.1.6",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.51.0",
    "gsap": "3.15.1",
    "ignore": "^7.0.16",
    "lucide-react": "^0.577.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-google-recaptcha": "^3.1.0",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "three": "^0.183.2",
    "uuid": "^14.0.3",
    "waait": "^1.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.3.4",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@sparkjsdev/spark": "2.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "2.1.9",
    "@types/three": "^0.183.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "esbuild": "0.28.2",
    "kill-port": "^2.0.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wait-on": "^9.5.1"
  }
}
